# DripRack Admin Frontend Environment Configuration
# ==============================================================================
# NOTICE: All VITE_* environment variables are baked into public client bundle
# assets at build time. NEVER place private secrets, API secret keys, database
# URIs, or signing keys in this file or any frontend configuration.
# ==============================================================================

# API Base URL pointing to the deployed DripRack backend REST API (must end in /api/v1)
# Local development default: http://localhost:5000/api/v1
# Production example: https://api.driprack.example.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Currency code matching the backend CURRENCY_CODE (default: USD)
# Must match backend configuration to ensure consistent minor-unit integer cent formatting.
VITE_CURRENCY_CODE=USD
